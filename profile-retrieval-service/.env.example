HTTP_ADDR=:8080

# One expensive profile retrieval per caller per window by default.
# Set PROFILE_RETRIEVE_RATE_LIMIT_REQUESTS=-1 to disable the inbound limiter.
PROFILE_RETRIEVE_RATE_LIMIT_REQUESTS=1
PROFILE_RETRIEVE_RATE_LIMIT_WINDOW=2m

# Keep outbound LinkedIn requests paced instead of bursting concurrently.
# Set LINKEDIN_REQUEST_MIN_INTERVAL=-1s to disable outbound pacing.
LINKEDIN_REQUEST_MIN_INTERVAL=3s

# Preferred when copying from an authenticated browser request.
LINKEDIN_COOKIE_HEADER=
LINKEDIN_CSRF_TOKEN=

# Alternative: provide only the core LinkedIn session cookies.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
